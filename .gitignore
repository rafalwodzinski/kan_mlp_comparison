# ---------------------------------------------------------
# Python
# ---------------------------------------------------------
venv/
.venv/
env/
.env
__pycache__/
*.py[cod]
*$py.class
*.so
.ipynb_checkpoints/

# ---------------------------------------------------------
# Data & experiment tracking
# ---------------------------------------------------------
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
mlruns/
wandb/
*.log
checkpoints/
saved_models/

# ---------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---------------------------------------------------------
# Manuscript, papers and literature (not part of the code release)
# ---------------------------------------------------------
manuscript/
papers/
literature/

# ---------------------------------------------------------
# Generated results: keep CSV data and PDF plots, drop the rest
# ---------------------------------------------------------
results/**/*.tex
results/**/*.md
*.png
*.svg
!results/**/*.csv
!results/plots/*.pdf

# ---------------------------------------------------------
# Temporary / agent helper scripts
# ---------------------------------------------------------
scratch/
sanity_check*.py
verify_*.py
temp_*.py
# Manuscript-only helper scripts (LaTeX table export, reference checking, Overleaf packaging)
scripts/verify_tex_references.py
scripts/export_auprc_tables.py
scripts/generate_figure_manifest.py

# Trained model weights (large; regenerate by re-running the benchmark)
*.pth
*.joblib
*.json
